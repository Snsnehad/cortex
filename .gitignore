# ---------------------------------------------------------------
# Secrets & local configuration — NEVER commit
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version.local

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# ---------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo
npm-debug.log*
.vite/
playwright-report/
test-results/

# ---------------------------------------------------------------
# Runtime data — uploaded documents, model caches, local volumes
# ---------------------------------------------------------------
# Anchored with a leading "/" so the source package backend/app/storage/ is NOT ignored.
/storage/
/uploads/
.data/
/model_cache/
.cache/
*.onnx

# Evaluation outputs may contain document text; reports go in docs/testing/
eval/runs/
eval/outputs/

# Logs & dumps
*.log
logs/
*.dump
*.sql.gz
qdrant_snapshots/

# ---------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Claude Code local settings (personal, may contain permissions)
.claude/settings.local.json

# Normalise all text files to LF in the repository; Git converts on checkout
# only where a rule below says so. This keeps diffs clean between Windows,
# the Linux Docker containers and CI.
* text=auto eol=lf

# Must stay LF even on Windows — they run inside Linux containers
*.sh        text eol=lf
Dockerfile  text eol=lf
*.Dockerfile text eol=lf

# Windows-only scripts keep CRLF
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary files: never touch line endings, never diff as text
*.pdf   binary
*.docx  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.zip   binary
*.onnx  binary

# Lockfiles: treat as generated for diffs/merges
uv.lock           linguist-generated=true -diff
package-lock.json linguist-generated=true -diff

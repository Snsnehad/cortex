# =====================================================================================
# Cortex configuration — copy to `.env` (never commit `.env`) and adjust.
#
# Every setting is a CORTEX_* environment variable. Nested groups use a double
# underscore: CORTEX_<GROUP>__<FIELD>. Real environment variables override this file.
# Unknown CORTEX_* variables are rejected at startup, so typos fail loudly.
#
# Values below are DEVELOPMENT defaults. In staging/production the app refuses to start
# with the default JWT secret or DB password, debug=true, non-https or "*" CORS origins,
# local storage, or insecure refresh cookies.
# Lines starting with "# CORTEX_" are optional; uncomment to set them.
# =====================================================================================

# --- Application ---------------------------------------------------------------------
# development | test | staging | production
CORTEX_ENVIRONMENT=development
CORTEX_DEBUG=false
# DEBUG | INFO | WARNING | ERROR
CORTEX_LOG_LEVEL=INFO
# json (one JSON object per line) | console (coloured, human-readable; local only)
CORTEX_LOG_FORMAT=json
# JSON list of allowed browser origins (the Vite dev server by default)
CORTEX_CORS_ORIGINS=["http://localhost:5173"]

# --- PostgreSQL -----------------------------------------------------------------------
# Use 127.0.0.1 rather than localhost: on Windows, async clients try IPv6 ::1 first and
# lose ~2 s per connection before falling back to IPv4.
CORTEX_DATABASE__HOST=127.0.0.1
# Host port of the compose Postgres (Cortex block avoids clashing with other projects)
CORTEX_DATABASE__PORT=15432
CORTEX_DATABASE__USER=cortex
CORTEX_DATABASE__PASSWORD=cortex
CORTEX_DATABASE__NAME=cortex
CORTEX_DATABASE__POOL_SIZE=10
CORTEX_DATABASE__MAX_OVERFLOW=10
# Log every SQL statement (very noisy; development only)
CORTEX_DATABASE__ECHO_SQL=false

# --- Redis (Celery broker, rate limits) -------------------------------------------------
CORTEX_REDIS__URL=redis://127.0.0.1:16379/0

# --- Qdrant (vector index) ---------------------------------------------------------------
CORTEX_QDRANT__URL=http://127.0.0.1:16333
# Required for Qdrant Cloud / secured deployments
# CORTEX_QDRANT__API_KEY=
CORTEX_QDRANT__COLLECTION_PREFIX=cortex_
CORTEX_QDRANT__TIMEOUT_SECONDS=10

# --- File storage --------------------------------------------------------------------
# local | s3   (staging/production require s3)
CORTEX_STORAGE__BACKEND=local
# Defaults to <repo>/.data/storage (git-ignored)
# CORTEX_STORAGE__LOCAL_ROOT=
# CORTEX_STORAGE__S3_BUCKET=
# CORTEX_STORAGE__S3_REGION=
# Only for S3-compatible services such as MinIO; leave unset for AWS
# CORTEX_STORAGE__S3_ENDPOINT_URL=
# 25 MB
CORTEX_STORAGE__MAX_UPLOAD_BYTES=26214400

# --- Authentication ------------------------------------------------------------------
# Generate a real secret for any shared environment, e.g.:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
CORTEX_AUTH__JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
CORTEX_AUTH__JWT_ALGORITHM=HS256
CORTEX_AUTH__ACCESS_TOKEN_TTL_SECONDS=900
CORTEX_AUTH__REFRESH_TOKEN_TTL_DAYS=14
# Must be true behind HTTPS (staging/production)
CORTEX_AUTH__REFRESH_COOKIE_SECURE=false

# --- Embeddings ----------------------------------------------------------------------
# fastembed (local, free) | openai_compatible
CORTEX_EMBEDDINGS__PROVIDER=fastembed
CORTEX_EMBEDDINGS__MODEL=BAAI/bge-small-en-v1.5
CORTEX_EMBEDDINGS__DIMENSIONS=384
# Bump when changing model/dimensions so vectors are never mixed (see ADR-008)
CORTEX_EMBEDDINGS__PROFILE_VERSION=1
CORTEX_EMBEDDINGS__BATCH_SIZE=32
# Only for provider=openai_compatible
# CORTEX_EMBEDDINGS__BASE_URL=
# CORTEX_EMBEDDINGS__API_KEY=

# --- LLM (any OpenAI-compatible chat completions API) -----------------------------------
CORTEX_LLM__BASE_URL=https://api.openai.com/v1
# Required for real answers; automated tests never need it
# CORTEX_LLM__API_KEY=
CORTEX_LLM__MODEL=gpt-4o-mini
CORTEX_LLM__TIMEOUT_SECONDS=60
CORTEX_LLM__MAX_OUTPUT_TOKENS=1024
CORTEX_LLM__TEMPERATURE=0.1

# --- Retrieval & RAG -----------------------------------------------------------------
CORTEX_RAG__CHUNK_SIZE_TOKENS=512
CORTEX_RAG__CHUNK_OVERLAP_TOKENS=64
CORTEX_RAG__TOP_K_DENSE=40
CORTEX_RAG__TOP_K_SPARSE=40
CORTEX_RAG__FUSED_K=30
CORTEX_RAG__RERANK_ENABLED=true
CORTEX_RAG__RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
CORTEX_RAG__RERANK_TOP_N=30
CORTEX_RAG__FINAL_K=6
CORTEX_RAG__DENSE_WEIGHT=1.0
CORTEX_RAG__SPARSE_WEIGHT=1.0
# Reciprocal Rank Fusion constant k
CORTEX_RAG__RRF_K=60
CORTEX_RAG__CONTEXT_MAX_TOKENS=6000
